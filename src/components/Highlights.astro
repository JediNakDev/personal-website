---
import { highlights, benchmarkContext } from '../data/cv';
---
<section class="highlights" aria-labelledby="selected-work">
  <h2 id="selected-work">Selected engineering work</h2>
  <div class="highlights-grid">
    {highlights.map(h => <a class="highlight-card" href={h.href}>
      <h3>{h.name}<span class="highlight-arrow" aria-hidden="true">&#8599;</span></h3>
      <p class="highlight-number">{h.value} <span>{h.unit}</span></p>
      <p>{h.description}</p>
      <p class="highlight-context">{h.context}</p>
    </a>)}
  </div>
  <p class="benchmark-context">{benchmarkContext}</p>
</section>
<style>
.highlights{max-width:1180px;margin:0 auto 70px;padding:30px 0}.highlights h2{font-size:25px;margin:0 0 25px}.highlights-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}/* resting state is identical to the plain card this replaced */.highlight-card{position:relative;display:block;border-top:1px solid currentColor;padding-top:20px;min-width:0;color:inherit;text-decoration:none;transition:transform .25s cubic-bezier(.2,.8,.3,1),border-top-color .25s ease}.highlight-card:hover,.highlight-card:focus-visible{transform:translateY(-4px);border-top-color:var(--signal)}.highlight-card:hover h3,.highlight-card:focus-visible h3{color:var(--signal)}/* absolute, so it takes no space while hidden */.highlight-arrow{position:absolute;top:20px;right:0;opacity:0;transform:translate(-5px,5px);transition:opacity .25s ease,transform .25s cubic-bezier(.2,.8,.3,1)}.highlight-card:hover .highlight-arrow,.highlight-card:focus-visible .highlight-arrow{opacity:1;transform:translate(0,0)}@media(prefers-reduced-motion:reduce){.highlight-card,.highlight-arrow{transition:none}.highlight-card:hover,.highlight-card:focus-visible{transform:none}}.highlights h3{font-size:17px;letter-spacing:0;margin:0}.highlight-number{font-size:40px;line-height:1.2;margin:20px 0;letter-spacing:-.04em}.highlight-number span{font-size:12px;letter-spacing:0;white-space:nowrap}.highlight-card>p:not(.highlight-number){font-size:14px;line-height:1.65}.highlights .highlight-context,.benchmark-context{font-size:11px;line-height:1.6;opacity:.8}.benchmark-context{margin-top:25px}@media(max-width:800px){.highlights-grid{grid-template-columns:1fr;gap:20px}.highlights{margin-bottom:40px}.highlight-number{margin:12px 0}}
</style>
