---
import { highlights } from '../data/cv';
---
<section class="highlights" aria-labelledby="selected-work">
  <h2 id="selected-work">Selected engineering work</h2>
  <div class="work-list">
    {highlights.map(h => <a class="work-row" href={h.href}>
      <div class="work-content">
        <div class="work-name">
          <p>{h.domain}</p>
          <h3>{h.name}</h3>
        </div>
        <p class="work-description">{h.description}</p>
        <div class="work-proof">
          <strong>{h.value}</strong>
          <span>{h.unit}</span>
          <small>{h.context}</small>
        </div>
        <span class="work-arrow" aria-hidden="true">&#8599;</span>
      </div>
    </a>)}
  </div>
</section>

<style>
  .highlights {
    max-width: 1180px;
    margin: 0 auto 70px;
    padding: 30px 0;
  }
  .highlights h2 {
    margin: 0 0 18px;
    font-size: 25px;
  }
  .work-list {
    border-top: 1px solid var(--ink);
  }
  .work-row {
    position: relative;
    display: block;
    isolation: isolate;
    border-bottom: 1px solid var(--grid);
    color: inherit;
    text-decoration: none;
  }
  .work-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(170px, .72fr) minmax(280px, 1.25fr) minmax(220px, .9fr) 18px;
    gap: clamp(18px, 3vw, 38px);
    align-items: center;
    min-height: 142px;
    padding: 22px 0;
    transition: transform .24s cubic-bezier(.2,.8,.3,1);
  }
  .work-row::before {
    content: "";
    position: absolute;
    inset: 0 -14px;
    z-index: 0;
    pointer-events: none;
    background: color-mix(in srgb, var(--signal) 7%, transparent);
    opacity: 0;
    transition: opacity .2s ease;
  }
  .work-row:hover .work-content,
  .work-row:focus-visible .work-content {
    transform: translateX(10px);
  }
  .work-row:hover::before,
  .work-row:focus-visible::before {
    opacity: 1;
  }
  .work-name p {
    margin: 0 0 9px;
    color: var(--signal);
    font: 10px/1.4 "Fragment Mono", monospace;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .work-name h3 {
    margin: 0;
    font: 600 clamp(18px, 2vw, 23px)/1.12 "Familjen Grotesk", system-ui, sans-serif;
    letter-spacing: -.025em;
  }
  .work-description {
    max-width: 52ch;
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
  }
  .work-proof {
    padding-left: 16px;
    border-left: 2px solid var(--signal);
  }
  .work-proof strong,
  .work-proof span,
  .work-proof small {
    display: block;
  }
  .work-proof strong {
    font: 600 clamp(21px, 2.6vw, 30px)/1.1 "Familjen Grotesk", system-ui, sans-serif;
    letter-spacing: -.035em;
  }
  .work-proof span,
  .work-proof small {
    font: 10px/1.5 "Fragment Mono", monospace;
  }
  .work-proof span {
    margin-top: 5px;
    color: var(--ink);
  }
  .work-proof small {
    margin-top: 7px;
    color: var(--mute);
  }
  .work-arrow {
    color: var(--signal);
    opacity: 0;
    transform: translate(-5px, 5px);
    transition: opacity .2s ease, transform .24s cubic-bezier(.2,.8,.3,1);
  }
  .work-row:hover .work-arrow,
  .work-row:focus-visible .work-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }
  @media (max-width: 800px) {
    .highlights {
      margin-bottom: 40px;
    }
    .work-content {
      grid-template-columns: 1fr 18px;
      gap: 14px 10px;
      padding: 24px 0;
    }
    .work-name,
    .work-description,
    .work-proof {
      grid-column: 1;
    }
    .work-description {
      max-width: 60ch;
    }
    .work-proof {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 3px 12px;
      align-items: baseline;
    }
    .work-proof strong {
      grid-row: 1 / span 2;
    }
    .work-proof span,
    .work-proof small {
      margin: 0;
    }
    .work-arrow {
      grid-column: 2;
      grid-row: 1;
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-row,
    .work-content,
    .work-row::before,
    .work-arrow {
      transition: none;
    }
  }
</style>
